# Copy to .env and adjust. Every variable is optional; defaults run the
# full pipeline offline (in-memory store + Ollama providers expected).

# Vector store: a PostgreSQL URL with the pgvector extension available.
# When pointing at Supabase's connection pooler, append ?sslmode=no-verify —
# the pooler presents a certificate chain signed by Supabase's own CA, which
# stock TLS verification rejects before the login is even attempted.
RAG_DATABASE_URL=
# Source DB for POST /ingest/companyos (defaults to RAG_DATABASE_URL).
RAG_COMPANYOS_DATABASE_URL=
RAG_TABLE_NAME=rag_chunks

# Providers: ollama | openai | dev
RAG_EMBEDDER=ollama
RAG_LLM=ollama

# Ollama (local open-weight models)
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_OLLAMA_LLM_MODEL=llama3.1

# OpenAI (used when a provider above is "openai")
RAG_OPENAI_API_KEY=
RAG_OPENAI_EMBED_MODEL=text-embedding-3-small
RAG_OPENAI_LLM_MODEL=gpt-4o-mini

# Must match the embedding model: nomic-embed-text 768,
# text-embedding-3-small 1536, dev 256.
RAG_EMBED_DIM=768

# Chunking and retrieval quality
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_MIN_SCORE=0.0

# Bearer token required on all endpoints except /health when set.
RAG_SERVICE_TOKEN=
